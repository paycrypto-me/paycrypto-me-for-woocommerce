#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 1 || ! $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo 'Usage: ./scripts/publish-wordpress X.Y.Z' >&2
  exit 2
fi
root="$(cd "$(dirname "$0")/.." && pwd)"
workspace="$root/releases/svn-$1"
[[ -d "$workspace/svn/.svn" ]] || { echo "Missing prepared checkout: $workspace/svn" >&2; exit 1; }
args=(-v "$1" -s paycrypto-me-for-woocommerce --no-build --no-tests --no-zip --no-docker --svn-publish-prepared)
if command -v podman >/dev/null && podman image exists "${SVN_TOOLS_IMAGE:-localhost/paycrypto-plugin-svn-tools:0.4.3}"; then
  exec podman run --rm -it -v "$root:/repo" -w /repo -e SVN_USER -e SVN_URL \
    -e "SVN_WORKSPACE=/repo/releases/svn-$1" --entrypoint bash \
    "${SVN_TOOLS_IMAGE:-localhost/paycrypto-plugin-svn-tools:0.4.3}" scripts/release.sh "${args[@]}"
fi
for tool in svn svnversion unzip rsync sha256sum diff python3; do
  if ! command -v "$tool" >/dev/null; then
    echo "Host fallback needs $tool. Install it or make the SVN tools image available in Podman." >&2
    exit 1
  fi
done
export SVN_WORKSPACE="$workspace"
exec bash "$root/scripts/release.sh" "${args[@]}"
