#. Plugin Name of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "PayCrypto.Me for WooCommerce"
msgstr "PayCrypto.Me for WooCommerce"

#. Plugin URI of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "https://paycrypto.me/woocommerce/"
msgstr "https://paycrypto.me/woocommerce/"

#. Description of the plugin
#: paycrypto-me-for-woocommerce.php
msgid ""
"PayCrypto.Me for WooCommerce lets your store accept Bitcoin payments — On-"
"Chain and Lightning Network — directly into wallets and nodes you control."
msgstr ""
"PayCrypto.Me для WooCommerce позволяет вашему магазину принимать платежи в "
"Bitcoin — On-Chain и Lightning Network — непосредственно в кошельки и узлы, "
"которыми вы управляете."

#. Author of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "PayCrypto.Me"
msgstr "PayCrypto.Me"

#. Author URI of the plugin
#: paycrypto-me-for-woocommerce.php
msgid "https://paycrypto.me/"
msgstr "https://paycrypto.me/"

#: exceptions/PayCryptoMePaymentException.php:19
msgid ""
"We couldn't complete your payment. Please try again or contact support if "
"the problem persists."
msgstr ""
"Не удалось завершить платёж. Попробуйте снова или обратитесь в поддержку, "
"если проблема повторяется."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:195
msgid ""
"We could not display the payment details for this order. Please contact the "
"store."
msgstr ""
"Не удалось показать платёжные данные этого заказа. Пожалуйста, свяжитесь с "
"магазином."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:291
msgid "Network"
msgstr "Сеть"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:294
msgid "Select the network for payments."
msgstr "Выберите сеть для платежей."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:303
msgid "Enable Method"
msgstr "Включить метод"

#. translators: %s: gateway title, e.g. "Bitcoin Payments (On-Chain)".
#: includes/abstract-class-wc-gateway-paycrypto-me.php:306
#, php-format
msgid "Enable %s"
msgstr "Включить %s"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:313
msgid "Title"
msgstr "Название"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:315
msgid "Payment method name displayed on Checkout page."
msgstr "Название способа оплаты, отображаемое на странице оформления заказа."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:316
#: includes/class-wc-gateway-paycrypto-me-lightning.php:37
#: includes/class-wc-gateway-paycrypto-me.php:41
#: includes/blocks/js/paycrypto_me-blocks.js:9
#: includes/blocks/js/paycrypto_me_lightning-blocks.js:9
msgid "Pay with Bitcoin"
msgstr "Оплатить Bitcoin"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:319
msgid "Description"
msgstr "Описание"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:321
msgid "Payment method description displayed on Checkout page."
msgstr "Описание способа оплаты, отображаемое на странице оформления заказа."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:322
#: includes/class-wc-gateway-paycrypto-me-lightning.php:38
#: includes/class-wc-gateway-paycrypto-me.php:42
msgid ""
"Pay directly from your Bitcoin wallet. Place your order to view the QR code "
"and payment instructions."
msgstr ""
"Платите прямо со своего кошелька Bitcoin. Разместите заказ, чтобы увидеть QR-"
"код и инструкции по оплате."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:325
msgid "Hide for Non-Admin Users"
msgstr "Скрыть для пользователей не-администраторов"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:326
msgid "Show only for administrators."
msgstr "Показать только администраторам."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:329
msgid ""
"If enabled, only administrators will see the payment method on Checkout page."
msgstr ""
"При включении только администраторы будут видеть способ оплаты на странице "
"оформления заказа."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:332
msgid "Debug"
msgstr "Отладка"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:333
msgid "Enable debugging messages"
msgstr "Включить сообщения отладки"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:336
msgid "Debug logs will be saved to WooCommerce > Status > Logs."
msgstr "Логи отладки будут сохранены в WooCommerce > Статус > Логи."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:340
msgid "Express Payment (One-Click)"
msgstr "Экспресс-платеж (один клик)"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:341
msgid ""
"Enable Express Payment to pay with one click. When enabled, customers are "
"redirected straight to the payment QR code."
msgstr ""
"Включить экспресс-платеж для оплаты одним щелчком. Если эта опция включена, "
"покупатели будут перенаправлены прямо на QR-код платежа."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:344
msgid "Enable Express Payment"
msgstr "Включить экспресс-платеж"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:350
msgid "Express Button Label"
msgstr "Метка кнопки Express"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:351
#: includes/abstract-class-wc-gateway-paycrypto-me.php:355
#: includes/class-wc-gateway-paycrypto-me-lightning.php:45
#: includes/class-wc-gateway-paycrypto-me.php:50
msgid "Buy with"
msgstr "Купить"

#. translators: %s: the actual default button label text (already translated elsewhere), shown quoted.
#: includes/abstract-class-wc-gateway-paycrypto-me.php:354
#, php-format
msgid ""
"Text displayed on the Express Payment button. If empty, the default label "
"will be used '%s'"
msgstr ""
"Текст на кнопке быстрой оплаты. Если поле пустое, будет использована "
"стандартная надпись «%s»"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:363
msgid "Express Button Icon"
msgstr "Значок кнопки Express"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:364
msgid "Show icon on Express Payment button"
msgstr "Показать значок на кнопке экспресс-платежа"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:367
msgid ""
"When enabled, the payment network icon is displayed alongside the button "
"label."
msgstr "При включении значок сети платежей отображается рядом с меткой кнопки."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:370
msgid "Icon Position"
msgstr "Позиция значка"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:373
msgid ""
"Controls where the icon appears relative to the button label. e.g. \"₿ Pay "
"with\" (left) or \"Pay with ₿\" (right)."
msgstr ""
"Контролирует расположение значка относительно метки кнопки. Например, \"₿ "
"Оплатить\" (слева) или \"Оплатить ₿\" (справа)."

#: includes/abstract-class-wc-gateway-paycrypto-me.php:375
msgid "Left — icon before label"
msgstr "Слева — значок перед меткой"

#: includes/abstract-class-wc-gateway-paycrypto-me.php:376
msgid "Right — icon after label"
msgstr "Справа — значок после метки"

#. translators: %s: short add-on name (not translated, product name), e.g. "Pro".
#: includes/abstract-class-wc-gateway-paycrypto-me.php:685
#, php-format
msgid "%s · Coming soon"
msgstr "%s · Скоро"

#. translators: %s: payment network name, e.g. "On-Chain" or "Lightning Network".
#: includes/abstract-class-wc-gateway-paycrypto-me.php:695
#, php-format
msgid "Bitcoin Payments (%s)"
msgstr "Платежи Bitcoin (%s)"

#. translators: %1$s: custody/hosting mode clause, e.g. "Non-custodial" or "self-hosted", %2$s: payment network name, %3$s: brand name (not translated, product name).
#: includes/abstract-class-wc-gateway-paycrypto-me.php:704
#, php-format
msgid "Accept Bitcoin payments %1$s via %2$s (Provided by %3$s)."
msgstr "Принимайте платежи Bitcoin %1$s через %2$s (предоставлено %3$s)."

#. translators: %1$s: feature description, %2$s: add-on name (not translated, product name), %3$s: free-version behavior description.
#: includes/abstract-class-wc-gateway-paycrypto-me.php:715
#, php-format
msgid "%1$s ships in the upcoming %2$s add-on. In the free version, %3$s."
msgstr "%1$s появится в готовящемся дополнении %2$s. В бесплатной версии %3$s."

#: includes/class-wc-gateway-paycrypto-me-lightning.php:28
#: includes/class-wc-gateway-paycrypto-me-lightning.php:31
#: includes/class-wc-gateway-paycrypto-me-lightning.php:393
msgid "Lightning Network"
msgstr "Lightning Network"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:30
msgid "self-hosted"
msgstr "на собственном сервере"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:115
msgid "Proxy Settings"
msgstr "Настройки прокси"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:117
msgid "Configure proxy settings for connecting to your Lightning node."
msgstr "Настройте параметры прокси для подключения к узлу Lightning."

#: includes/class-wc-gateway-paycrypto-me-lightning.php:120
msgid "Lightning Node Type"
msgstr "Тип узла Lightning"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:125
msgid "Invoice Expiry"
msgstr "Срок действия счета"

#: includes/class-wc-gateway-paycrypto-me-lightning.php:127
msgid ""
"Time before invoice expires. Min: 300 (5 min), Max: 86400 (24h). Default: "
"3600 (1 hour)"
msgstr ""
"Время до истечения счета. Мин: 300 (5 мин), Макс: 86400 (24ч). По умолчанию: "
"3600 (1 час)"

